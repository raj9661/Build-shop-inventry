apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: inventory-platform
type: Opaque
stringData:
  # Database URL
  DATABASE_URL: "postgresql://user:password@host:port/database?sslmode=verify-full"
  
  # Redis Configuration
  REDIS_URL: "redis://redis-service:6379"
  REDIS_PASSWORD: ""
  
  # JWT Secrets
  JWT_SECRET: "your-jwt-secret-key"
  JWT_REFRESH_SECRET: "your-jwt-refresh-secret-key"
  
  # Payment Gateway Secrets
  STRIPE_SECRET_KEY: "your-stripe-secret-key"
  RAZORPAY_KEY_ID: "your-razorpay-key-id"
  RAZORPAY_KEY_SECRET: "your-razorpay-key-secret"
  
  # NextAuth Secret
  NEXTAUTH_SECRET: "your-nextauth-secret-key"
  
  # Email Configuration (optional)
  SMTP_HOST: "smtp.gmail.com"
  SMTP_PORT: "587"
  SMTP_USER: "your-email@gmail.com"
  SMTP_PASS: "your-app-password"
  
  # Developer Bypass (optional)
  DEV_BYPASS_SECRET: "dev-bypass-2024-7f8e2c1a-4b6d-4e9a-9c2b-1d3f5a7b8c9d"

---
# Instructions:
# 1. Copy this file to secrets.yaml: cp k8s/secrets.yaml.example k8s/secrets.yaml
# 2. Update all values with your actual secrets
# 3. Apply: kubectl apply -f k8s/secrets.yaml
# 
# OR create secret from file:
# kubectl create secret generic app-secrets \
#   --from-literal=DATABASE_URL='your-db-url' \
#   --from-literal=REDIS_URL='redis://redis-service:6379' \
#   --from-literal=JWT_SECRET='your-jwt-secret' \
#   --namespace=inventory-platform

