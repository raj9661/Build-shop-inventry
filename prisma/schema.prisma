generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model PlatformOwner {
  id                 BigInt              @id @default(sequence())
  name               String
  email              String              @unique
  phone              String?
  companyName        String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  notifications      Notification[]
  platformAnalytics  PlatformAnalytics[]
  subscriptions      Subscription[]
  assignedViolations Violation[]         @relation("ViolationAssignee")
  violations         Violation[]
  websiteSettings    WebsiteSetting[]

  @@index([email])
  @@index([isActive])
}

model Subscription {
  id              BigInt                @id @default(sequence())
  customerId      BigInt                @unique
  plan            SubscriptionPlan
  status          SubscriptionStatus    @default(TRIAL)
  startDate       DateTime
  endDate         DateTime
  trialEndDate    DateTime?
  autoRenew       Boolean               @default(true)
  price           Decimal               @db.Decimal(10, 2)
  currency        String                @default("USD")
  paymentMethod   PaymentMethod?
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdBy       BigInt?
  platformOwner   PlatformOwner?        @relation(fields: [createdBy], references: [id])
  customer        User                  @relation("CustomerSubscription", fields: [customerId], references: [id])
  payments        SubscriptionPayment[]
  usage           SubscriptionUsage[]

  @@index([customerId])
  @@index([status])
  @@index([plan])
  @@index([endDate])
  @@index([isActive])
}

model SubscriptionPayment {
  id              BigInt        @id @default(sequence())
  subscriptionId  BigInt
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  transactionId   String?
  gatewayResponse String?
  paymentDate     DateTime?
  failureReason   String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([isActive])
}

model SubscriptionUsage {
  id             BigInt       @id @default(sequence())
  subscriptionId BigInt
  metric         String
  usage          Int
  limit          Int?
  period         String
  recordedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([metric])
  @@index([recordedAt])
}

model Violation {
  id          BigInt          @id @default(sequence())
  customerId  BigInt
  type        ViolationType
  status      ViolationStatus @default(REPORTED)
  title       String
  description String
  evidence    String?
  reportedBy  BigInt?
  assignedTo  BigInt?
  resolution  String?
  actionTaken String?
  severity    Int             @default(1)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  resolvedAt  DateTime?
  assignee    PlatformOwner?  @relation("ViolationAssignee", fields: [assignedTo], references: [id])
  customer    User            @relation("CustomerViolation", fields: [customerId], references: [id])
  reporter    PlatformOwner?  @relation(fields: [reportedBy], references: [id])

  @@index([customerId])
  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([isActive])
}

model Notification {
  id            BigInt           @id @default(sequence())
  recipientId   BigInt?
  recipientType String
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  isActive      Boolean          @default(true)
  scheduledFor  DateTime?
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     BigInt?
  platformOwner PlatformOwner?   @relation(fields: [createdBy], references: [id])

  @@index([recipientId])
  @@index([recipientType])
  @@index([type])
  @@index([isRead])
  @@index([isActive])
}

model WebsiteSetting {
  id            BigInt             @id @default(sequence())
  customerId    BigInt?
  type          WebsiteSettingType
  key           String
  value         String
  description   String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdBy     BigInt?
  platformOwner PlatformOwner?     @relation(fields: [createdBy], references: [id])
  customer      User?              @relation("CustomerWebsiteSettings", fields: [customerId], references: [id])

  @@unique([customerId, type, key])
  @@index([customerId])
  @@index([type])
  @@index([isActive])
}

model PlatformAnalytics {
  id            BigInt         @id @default(sequence())
  metric        String
  value         Decimal        @db.Decimal(15, 2)
  metadata      String?
  recordedAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  createdBy     BigInt?
  platformOwner PlatformOwner? @relation(fields: [createdBy], references: [id])

  @@index([metric])
  @@index([recordedAt])
}

model User {
  id                      BigInt               @id @default(sequence())
  name                    String
  username                String               @unique
  email                   String               @unique
  password                String
  role                    PlatformRole         @default(STAFF)
  phone                   String?              @unique
  isActive                Boolean              @default(true)
  lastLoginAt             DateTime?
  emailVerified           Boolean              @default(false)
  emailVerificationToken  String?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  twoFactorEnabled        Boolean              @default(false)
  twoFactorSecret         String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  createdBy               BigInt?
  updatedBy               BigInt?
  activityLogs            ActivityLog[]
  loginLogs               LoginLog[]
  categoriesCreated       ProductCategory[]    @relation("CategoryCreatedBy")
  typesCreated            ProductType[]        @relation("TypeCreatedBy")
  shopsCreated            Shop[]               @relation("ShopCreatedBy")
  shopsUpdated            Shop[]               @relation("ShopUpdatedBy")
  customerSubscription    Subscription?        @relation("CustomerSubscription")
  trustedDevices          TrustedDevice[]
  createdByUser           User?                @relation("UserCreatedBy", fields: [createdBy], references: [id])
  usersCreated            User[]               @relation("UserCreatedBy")
  updatedByUser           User?                @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  usersUpdated            User[]               @relation("UserUpdatedBy")
  user2FASetting          User2FASetting?
  shopAssignmentsCreated  UserShopAssignment[] @relation("ShopAssignmentCreatedBy")
  shopAssignments         UserShopAssignment[]
  customerViolations      Violation[]          @relation("CustomerViolation")
  customerWebsiteSettings WebsiteSetting[]     @relation("CustomerWebsiteSettings")
  saleDocuments           SaleDocument[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([email])
  @@index([emailVerified])
}

model Shop {
  id                    BigInt                  @id @default(sequence())
  name                  String
  location              String?
  phone                 String?
  email                 String?
  address               String?
  gstNo                 String?
  isActive              Boolean                 @default(true)
  createdBy             BigInt?
  updatedBy             BigInt?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  analyticsSummaries    AnalyticsSummary[]
  businessGoals         BusinessGoal[]
  businessMetrics       BusinessMetric[]
  customers             Customer[]
  customerLedgerEntries CustomerLedgerEntry[]
  employees             Employee[]
  employeePayments      EmployeePayment[]
  employeeSalaryDues    EmployeeSalaryDue[]
  expenses              Expense[]
  inventoryAnalytics    InventoryAnalytics[]
  payments              Payment[]
  products              Product[]
  categories            ProductCategory[]
  productSalesAnalytics ProductSalesAnalytics[]
  productTypes          ProductType[]
  sales                 Sale[]
  createdByUser         User?                   @relation("ShopCreatedBy", fields: [createdBy], references: [id])
  updatedByUser         User?                   @relation("ShopUpdatedBy", fields: [updatedBy], references: [id])
  stockEntries          StockEntry[]
  suppliers             Supplier[]
  supplierPayments      SupplierPayment[]
  supplierWeeklyReports SupplierWeeklyReport[]
  tmtCompanies          TmtCompany[]
  tmtInventory          TmtInventory[]
  tmtProducts           TmtProduct[]
  tmtPurchases          TmtPurchase[]
  tmtSales              TmtSale[]
  tmtSizes              TmtSize[]
  userAssignments       UserShopAssignment[]
  stockLedgerEntries    StockLedger[]
  saleDocuments         SaleDocument[]

  @@index([isActive])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([name])
  @@index([location])
}

model ProductCategory {
  id            BigInt        @id @default(sequence())
  name          String
  description   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shopId        BigInt?
  createdBy     BigInt?
  products      Product[]
  createdByUser User?         @relation("CategoryCreatedBy", fields: [createdBy], references: [id])
  shop          Shop?         @relation(fields: [shopId], references: [id])
  types         ProductType[]

  @@unique([name, shopId])
  @@index([shopId])
  @@index([isActive])
  @@index([createdAt])
  @@index([createdBy])
}

model ProductType {
  id            BigInt          @id @default(sequence())
  name          String
  description   String?
  categoryId    BigInt
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  shopId        BigInt?
  bundleSize    Int?
  createdBy     BigInt?
  products      Product[]
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  createdByUser User?           @relation("TypeCreatedBy", fields: [createdBy], references: [id])
  shop          Shop?           @relation(fields: [shopId], references: [id])

  @@unique([name, shopId])
  @@index([categoryId])
  @@index([shopId])
  @@index([isActive])
  @@index([createdBy])
}

model Product {
  id                 BigInt                  @id @default(sequence())
  name               String
  description        String?
  categoryId         BigInt
  typeId             BigInt
  shopId             BigInt
  sku                String?
  barcode            String?
  unit               String
  price              Decimal                 @db.Decimal(10, 2)
  costPrice          Decimal                 @db.Decimal(10, 2)
  stockQuantity      Decimal                 @default(0) @db.Decimal(12, 3)
  minStockLevel      Decimal                 @default(0) @db.Decimal(12, 3)
  maxStockLevel      Decimal?
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  damagedQuantity    Decimal                 @default(0) @db.Decimal(12, 3)
  specialPrices      CustomerSpecialPrice[]
  dailyPrices        DailyProductPrice[]
  inventoryAnalytics InventoryAnalytics[]
  category           ProductCategory         @relation(fields: [categoryId], references: [id])
  shop               Shop                    @relation(fields: [shopId], references: [id])
  type               ProductType             @relation(fields: [typeId], references: [id])
  salesAnalytics     ProductSalesAnalytics[]
  saleItems          SaleItem[]
  stockEntries       StockEntry[]
  unitConversions    ProductUnitConversion[]
  stockLedgerEntries StockLedger[]

  @@index([sku])
  @@index([barcode])
  @@index([shopId, createdAt])
  @@index([categoryId])
  @@index([typeId])
  @@index([isActive])
  @@index([name])
}

model DailyProductPrice {
  id        BigInt   @id @default(sequence())
  productId BigInt
  date      DateTime
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([productId, date])
  @@index([date])
  @@index([productId])
}

model Supplier {
  id                 BigInt                 @id @default(sequence())
  name               String
  phone              String?
  email              String?
  address            String?
  gstNo              String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  shopId             BigInt
  outstandingPayment Decimal                @default(0) @db.Decimal(12, 2)
  openingBalance     Decimal                @default(0) @db.Decimal(12, 2)
  stockEntries       StockEntry[]
  shop               Shop                   @relation(fields: [shopId], references: [id])
  payments           SupplierPayment[]
  weeklyReports      SupplierWeeklyReport[]
  tmtInventories     TmtInventory[]

  @@index([shopId])
  @@index([isActive])
  @@index([name])
  @@index([phone])
}

model StockEntry {
  id            BigInt        @id @default(sequence())
  productId     BigInt
  supplierId    BigInt
  quantity      Decimal       @db.Decimal(12, 3)
  unitName      String?
  conversionCft Decimal?      @db.Decimal(12, 3)
  unitPrice     Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  entryDate     DateTime
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shopId        BigInt
  paymentStatus PaymentStatus @default(PENDING)
  product       Product       @relation(fields: [productId], references: [id])
  shop          Shop          @relation(fields: [shopId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@index([shopId])
  @@index([entryDate])
  @@index([isActive])
  @@index([paymentStatus])
}

model SupplierPayment {
  id            BigInt        @id @default(sequence())
  supplierId    BigInt
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shopId        BigInt
  shop          Shop          @relation(fields: [shopId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([shopId])
  @@index([paymentDate])
  @@index([isActive])
}

model SupplierWeeklyReport {
  id            BigInt   @id @default(sequence())
  supplierId    BigInt
  weekStartDate DateTime
  weekEndDate   DateTime
  totalSupplied Decimal  @db.Decimal(12, 2)
  totalPaid     Decimal  @db.Decimal(12, 2)
  outstanding   Decimal  @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shopId        BigInt
  shop          Shop     @relation(fields: [shopId], references: [id])
  supplier      Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([shopId])
  @@index([weekStartDate])
  @@index([isActive])
}

model Employee {
  id         BigInt              @id @default(sequence())
  name       String
  phone      String?
  email      String?
  address    String?
  position   String?
  salary     Decimal?            @db.Decimal(10, 2)
  joinDate   DateTime?
  isActive   Boolean             @default(true)
  salaryType String              @default("monthly")
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  shopId     BigInt
  shop       Shop                @relation(fields: [shopId], references: [id])
  payments   EmployeePayment[]
  salaryDues EmployeeSalaryDue[]

  @@index([shopId])
  @@index([isActive])
  @@index([name])
  @@index([position])
}

model EmployeePayment {
  id            BigInt        @id @default(sequence())
  employeeId    BigInt
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shopId        BigInt
  employee      Employee      @relation(fields: [employeeId], references: [id])
  shop          Shop          @relation(fields: [shopId], references: [id])

  @@index([employeeId])
  @@index([shopId])
  @@index([paymentDate])
  @@index([isActive])
}

model EmployeeSalaryDue {
  id         BigInt   @id @default(sequence())
  employeeId BigInt
  amount     Decimal  @db.Decimal(10, 2)
  dueDate    DateTime
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shopId     BigInt
  employee   Employee @relation(fields: [employeeId], references: [id])
  shop       Shop     @relation(fields: [shopId], references: [id])

  @@index([employeeId])
  @@index([shopId])
  @@index([dueDate])
  @@index([isActive])
}

model Customer {
  id             BigInt                 @id @default(sequence())
  name           String
  phone          String?
  email          String?
  address        String?
  gstNo          String?
  customerType   CustomerType           @default(REGULAR)
  creditLimit    Decimal                @default(0) @db.Decimal(12, 2)
  currentBalance Decimal                @default(0) @db.Decimal(12, 2)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  shopId         BigInt
  shop           Shop                   @relation(fields: [shopId], references: [id])
  ledgerEntries  CustomerLedgerEntry[]
  specialPrices  CustomerSpecialPrice[]
  sales          Sale[]
  tmtSales       TmtSale[]

  @@index([shopId])
  @@index([isActive])
  @@index([name])
  @@index([phone])
  @@index([customerType])
}

model CustomerSpecialPrice {
  id           BigInt   @id @default(sequence())
  customerId   BigInt
  productId    BigInt
  specialPrice Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@index([isActive])
}

model CustomerLedgerEntry {
  id          BigInt        @id @default(sequence())
  customerId  BigInt
  amount      Decimal       @db.Decimal(12, 2)
  type        String
  method      PaymentMethod
  date        DateTime
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shopId      BigInt
  customer    Customer      @relation(fields: [customerId], references: [id])
  shop        Shop          @relation(fields: [shopId], references: [id])

  @@index([customerId])
  @@index([shopId])
  @@index([date])
  @@index([type])
  @@index([isActive])
}

model Sale {
  id            BigInt        @id @default(sequence())
  customerId    BigInt?
  totalAmount   Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount   Decimal       @db.Decimal(12, 2)
  transportFare Decimal       @default(0) @db.Decimal(12, 2)
  vehicleNumber String?
  driverName    String?
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  saleDate      DateTime
  notes         String?
  status        SaleStatus    @default(PENDING)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shopId        BigInt
  customer      Customer?     @relation(fields: [customerId], references: [id])
  shop          Shop          @relation(fields: [shopId], references: [id])
  items         SaleItem[]

  @@index([customerId])
  @@index([shopId])
  @@index([saleDate])
  @@index([paymentStatus])
  @@index([status])
  @@index([isActive])
  // Composite indexes for common query patterns
  @@index([shopId, saleDate])           // Dashboard + sales list by shop & date
  @@index([shopId, paymentStatus])      // Filter active/completed by shop
  @@index([shopId, isActive, saleDate]) // Ultra-fast dashboard range queries
}

model SaleItem {
  id         BigInt   @id @default(sequence())
  saleId     BigInt
  productId  BigInt
  quantity   Decimal  @db.Decimal(12, 3)
  unitName   String?
  conversionCft Decimal? @db.Decimal(12, 3)
  unit       String?
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])
  sale       Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([isActive])
}

model Payment {
  id          BigInt        @id @default(sequence())
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  purpose     String
  description String?
  date        DateTime
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shopId      BigInt
  shop        Shop          @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([date])
  @@index([method])
  @@index([isActive])
}

model Expense {
  id          BigInt          @id @default(sequence())
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  description String?
  date        DateTime
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  shopId      BigInt
  shop        Shop            @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([date])
  @@index([category])
  @@index([isActive])
}

model AnalyticsSummary {
  id             BigInt   @id @default(sequence())
  date           DateTime
  totalSales     Decimal  @db.Decimal(12, 2)
  totalExpenses  Decimal  @db.Decimal(12, 2)
  netProfit      Decimal  @db.Decimal(12, 2)
  totalCustomers Int
  totalProducts  Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shopId         BigInt
  shop           Shop     @relation(fields: [shopId], references: [id])

  @@unique([date, shopId])
  @@index([shopId])
  @@index([date])
  @@index([isActive])
}

model ProductSalesAnalytics {
  id           BigInt   @id @default(sequence())
  productId    BigInt
  date         DateTime
  quantitySold Decimal  @db.Decimal(12, 3)
  totalRevenue Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shopId       BigInt
  product      Product  @relation(fields: [productId], references: [id])
  shop         Shop     @relation(fields: [shopId], references: [id])

  @@unique([productId, date, shopId])
  @@index([productId])
  @@index([shopId])
  @@index([date])
  @@index([isActive])
}

model BusinessMetric {
  id         BigInt   @id @default(sequence())
  metricName String
  value      Decimal  @db.Decimal(12, 4)
  formula    String?
  period     String
  recordedAt DateTime @default(now())
  shopId     BigInt
  shop       Shop     @relation(fields: [shopId], references: [id])

  @@index([metricName])
  @@index([period])
  @@index([recordedAt])
  @@index([shopId])
}

model InventoryAnalytics {
  id              BigInt   @id @default(sequence())
  shopId          BigInt
  productId       BigInt
  avgStock        Decimal  @db.Decimal(12, 2)
  cogs            Decimal  @db.Decimal(12, 2)
  turnoverRatio   Decimal  @db.Decimal(12, 4)
  daysInInventory Decimal  @db.Decimal(12, 2)
  recordedAt      DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])
  shop            Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([productId])
  @@index([recordedAt])
}

model BusinessGoal {
  id          BigInt    @id @default(sequence())
  metricName  String
  targetValue Decimal   @db.Decimal(12, 2)
  period      String
  achieved    Boolean   @default(false)
  achievedAt  DateTime?
  shopId      BigInt
  shop        Shop      @relation(fields: [shopId], references: [id])
}

model TmtCompany {
  id        BigInt       @id @default(sequence())
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  shopId    BigInt?
  shop      Shop?        @relation(fields: [shopId], references: [id])
  products  TmtProduct[]

  @@unique([name, shopId])
  @@index([shopId])
  @@index([isActive])
  @@index([name])
}

model TmtSize {
  id        BigInt       @id @default(sequence())
  sizeMm    Decimal      @db.Decimal(5, 1)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  shopId    BigInt?
  products  TmtProduct[]
  shop      Shop?        @relation(fields: [shopId], references: [id])

  @@unique([sizeMm, shopId])
  @@index([shopId])
  @@index([isActive])
  @@index([sizeMm])
}

model TmtProduct {
  id                BigInt            @id @default(sequence())
  productName       String
  companyId         BigInt
  sizeId            BigInt
  weightPerRodKg    Decimal           @db.Decimal(8, 3)
  rodsPerBundle     Int
  weightPerBundleKg Decimal           @db.Decimal(8, 3)
  defaultUnit       TmtUnitType       @default(KG)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  shopId            BigInt?
  inventory         TmtInventory[]
  company           TmtCompany        @relation(fields: [companyId], references: [id])
  shop              Shop?             @relation(fields: [shopId], references: [id])
  size              TmtSize           @relation(fields: [sizeId], references: [id])
  purchases         TmtPurchaseItem[]
  sales             TmtSaleItem[]

  @@unique([companyId, sizeId, shopId])
  @@index([companyId])
  @@index([sizeId])
  @@index([shopId])
  @@index([isActive])
  @@index([productName])
}

model TmtPurchase {
  id             BigInt            @id @default(sequence())
  invoiceNumber  String
  supplierName   String
  totalWeightTon Decimal           @db.Decimal(10, 2)
  dateReceived   DateTime
  remarks        String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  shopId         BigInt
  shop           Shop              @relation(fields: [shopId], references: [id])
  items          TmtPurchaseItem[]

  @@index([shopId])
  @@index([dateReceived])
  @@index([invoiceNumber])
  @@index([isActive])
}

model TmtPurchaseItem {
  id                BigInt      @id @default(sequence())
  purchaseId        BigInt
  productId         BigInt
  quantity          Decimal     @db.Decimal(10, 2)
  unitType          TmtUnitType
  weightPerRodKg    Decimal     @db.Decimal(8, 3)
  rodsPerBundle     Int
  weightPerBundleKg Decimal     @db.Decimal(8, 3)
  totalBundles      Decimal     @db.Decimal(10, 2)
  totalPieces       Decimal     @db.Decimal(10, 2)
  equivalentKg      Decimal     @db.Decimal(10, 2)
  remarks           String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           TmtProduct  @relation(fields: [productId], references: [id])
  purchase          TmtPurchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([isActive])
}

model TmtInventory {
  id                    BigInt     @id @default(sequence())
  productId             BigInt
  availableQtyKg        Decimal    @db.Decimal(12, 3)
  reservedQtyKg         Decimal    @default(0) @db.Decimal(12, 3)
  lastUpdated           DateTime   @default(now())
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  shopId                BigInt
  costPricePerKg        Decimal?   @db.Decimal(10, 2)
  maxStockKg            Decimal?   @db.Decimal(12, 3)
  minStockKg            Decimal?   @db.Decimal(12, 3)
  sellingPricePerKg     Decimal?   @db.Decimal(10, 2)
  supplierId            BigInt?
  totalAmount           Decimal?   @db.Decimal(12, 2)
  costPricePerPiece     Decimal?   @db.Decimal(10, 2)
  sellingPricePerPiece  Decimal?   @db.Decimal(10, 2)
  totalAmountFromKg     Decimal?   @db.Decimal(12, 2)
  totalAmountFromPieces Decimal?   @db.Decimal(12, 2)
  product               TmtProduct @relation(fields: [productId], references: [id])
  shop                  Shop       @relation(fields: [shopId], references: [id])
  supplier              Supplier?  @relation(fields: [supplierId], references: [id])

  @@unique([productId, shopId])
  @@index([productId])
  @@index([shopId])
  @@index([supplierId])
  @@index([lastUpdated])
  @@index([isActive])
}

model TmtSale {
  id            BigInt           @id @default(sequence())
  customerName  String?
  customerId    BigInt?
  customer      Customer?        @relation(fields: [customerId], references: [id])
  totalAmount   Decimal          @db.Decimal(12, 2)
  paidAmount    Decimal?         @db.Decimal(12, 2)
  dueAmount     Decimal?         @db.Decimal(12, 2)
  paymentStatus TmtPaymentStatus @default(PAID)
  paymentMethod PaymentMethod
  saleDate      DateTime
  notes         String?
  status        SaleStatus       @default(PENDING)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  shopId        BigInt
  shop          Shop             @relation(fields: [shopId], references: [id])
  items         TmtSaleItem[]

  @@index([shopId])
  @@index([saleDate])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([isActive])
}

model TmtSaleItem {
  id                BigInt      @id @default(sequence())
  saleId            BigInt
  productId         BigInt
  quantity          Decimal     @db.Decimal(10, 2)
  unitType          TmtUnitType
  unitPrice         Decimal     @db.Decimal(10, 2)
  totalPrice        Decimal     @db.Decimal(12, 2)
  weightPerRodKg    Decimal     @db.Decimal(8, 3)
  rodsPerBundle     Int
  weightPerBundleKg Decimal     @db.Decimal(8, 3)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           TmtProduct  @relation(fields: [productId], references: [id])
  sale              TmtSale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([isActive])
}

model TrustedDevice {
  id                BigInt   @id @default(sequence())
  userId            BigInt
  deviceId          String
  deviceName        String
  ipAddress         String?
  userAgent         String?
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  deviceFingerprint Json?
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
}

model User2FASetting {
  id         BigInt   @id @default(sequence())
  userId     BigInt   @unique
  otp_method String
  secret     String?
  isEnabled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model UserShopAssignment {
  id           BigInt       @id @default(sequence())
  userId       BigInt
  shopId       BigInt
  role         PlatformRole
  assignedAt   DateTime     @default(now())
  active       Boolean      @default(true)
  assignedById BigInt
  assignedBy   User         @relation("ShopAssignmentCreatedBy", fields: [assignedById], references: [id])
  shop         Shop         @relation(fields: [shopId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, shopId])
  @@index([shopId])
  @@index([userId])
  @@index([active])
  @@index([userId, active])  // Hot path: getAuthContext cache-miss query
}

model LoginLog {
  id            BigInt   @id @default(sequence())
  userId        BigInt
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([success])
}

model ActivityLog {
  id         BigInt   @id @default(sequence())
  userId     BigInt
  action     String
  resource   String
  resourceId BigInt?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action])
  @@index([resource])
}

model ProductUnitConversion {
  id        BigInt   @id @default(sequence())
  productId BigInt
  unitName  String
  cftValue  Decimal  @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, unitName])
  @@index([productId])
}

model StockLedger {
  id              BigInt   @id @default(sequence())
  productId       BigInt
  shopId          BigInt
  transactionType String // PURCHASE, SALE, DIRECT_SALE, ADJUSTMENT, LOSS
  unitName        String
  unitQuantity    Decimal  @db.Decimal(12, 3)
  cftQuantity     Decimal  @db.Decimal(12, 3)
  referenceId     BigInt?
  notes           String?
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])

  @@index([productId])
  @@index([shopId])
}

model SaleDocument {
  id           BigInt   @id @default(sequence())
  shopId       BigInt
  uploadedBy   BigInt
  fileName     String   // stored object key in B2
  originalName String   // original filename from user
  fileUrl      String   // B2 download URL
  fileKey      String   // B2 object key for deletion
  fileSize     Int      // in bytes
  mimeType     String
  documentDate DateTime // date of the sale/bill/invoice
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop     @relation(fields: [shopId], references: [id])
  uploader     User     @relation(fields: [uploadedBy], references: [id])

  @@index([shopId])
  @@index([uploadedBy])
  @@index([documentDate])
  @@index([isActive])
  @@index([shopId, documentDate])
  @@index([shopId, isActive])
}

enum PlatformRole {
  PLATFORM_OWNER
  SUPER_DUPER_ADMIN
  SUPER_ADMIN
  ADMIN
  USER
  STAFF
  MODERATOR
  CREATOR
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
  PAYMENT_FAILED
}

enum SubscriptionPlan {
  TRIAL_30_DAYS
  BASIC_MONTHLY
  BASIC_YEARLY
  PROFESSIONAL_MONTHLY
  PROFESSIONAL_YEARLY
  ENTERPRISE_MONTHLY
  ENTERPRISE_YEARLY
}

