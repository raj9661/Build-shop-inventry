  WHOLESALE
  RETAIL
  CONTRACTOR
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  INTERNET
  SALARY
  MAINTENANCE
  MARKETING
  TRANSPORTATION
  OTHER
}

