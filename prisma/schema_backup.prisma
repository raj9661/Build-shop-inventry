generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                  @id @default(sequence(maxValue: 2147483647))
  name                   String
  username               String               @unique
  email                  String               @unique
  password               String
  role                   UserRole             @default(STAFF)
  phone                  String?
  isActive               Boolean              @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  createdBy              Int?
  updatedBy              Int?
  trustedDevices         TrustedDevice[]
  user2FASetting         User2FASetting?
  shopAssignmentsCreated UserShopAssignment[] @relation("ShopAssignmentCreatedBy")
  shopAssignments        UserShopAssignment[]
}

model UserShopAssignment {
  id           BigInt   @id @default(sequence())
  userId       Int
  shopId       Int
  role         UserRole
  assignedAt   DateTime @default(now())
  active       Boolean  @default(true)
  assignedById Int
  assignedBy   User     @relation("ShopAssignmentCreatedBy", fields: [assignedById], references: [id])
  shop         Shop     @relation(fields: [shopId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, shopId])
}

model User2FASetting {
  id         BigInt   @id @default(sequence())
  userId     Int      @unique
  otp_method String
  secret     String?
  isEnabled  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}

model TrustedDevice {
  id         BigInt   @id @default(sequence())
  userId     Int
  deviceId   String
  deviceName String
  ipAddress  String?
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
}

model LoginLog {
  id            BigInt   @id @default(sequence())
  userId        Int
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())
}

model ActivityLog {
  id         BigInt   @id @default(sequence())
  userId     Int
  action     String
  resource   String
  resourceId Int?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model Shop {
  id                    Int                    @id @default(sequence(maxValue: 2147483647))
  name                  String                 @unique
  location              String
  phone                 String?
  email                 String?
  address               String?
  gstNo                 String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdBy             Int?
  updatedBy             Int?
  // Relations
  userAssignments       UserShopAssignment[]
  products              Product[]
  sales                 Sale[]
  customers             Customer[]
  suppliers             Supplier[]
  employees             Employee[]
  stockEntries          StockEntry[]
  supplierPayments      SupplierPayment[]
  supplierWeeklyReports SupplierWeeklyReport[]
  employeePayments      EmployeePayment[]
  employeeSalaryDues    EmployeeSalaryDue[]
  payments              Payment[]
  expenses              Expense[]
  analyticsSummaries    AnalyticsSummary[]
  productSalesAnalytics ProductSalesAnalytics[]
  categories            ProductCategory[]
  productTypes          ProductType[]
  customerLedgerEntries CustomerLedgerEntry[]
  // TMT Bar Relations
  tmtPurchases          TmtPurchase[]
  tmtInventory          TmtInventory[]
  tmtSales              TmtSale[]
  tmtBars               TmtBar[]
}

model ProductCategory {
  id          Int      @id @default(sequence(maxValue: 2147483647))
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Int?
  updatedBy   Int?
  shopId      Int?     // Optional for global categories
  shop        Shop?    @relation(fields: [shopId], references: [id])

  // Relations
  products    Product[]
  types       ProductType[]
}

model ProductType {
  id          Int               @id @default(sequence(maxValue: 2147483647))
  name        String            @unique
  description String?
  categoryId  Int
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   Int?
  updatedBy   Int?
  shopId      Int?              // Optional for global types
  shop        Shop?             @relation(fields: [shopId], references: [id])
  bundleSize  Int?              // NEW: Number of pieces per bundle (for TMT bars)
  
  // Relations
  category    ProductCategory   @relation(fields: [categoryId], references: [id])
  products    Product[]
}

model Product {
  id              Int      @id @default(sequence(maxValue: 2147483647))
  name            String
  description     String?
  categoryId      Int
  typeId          Int
  shopId          Int
  sku             String?  @unique
  barcode         String?
  unit            String
  price           Decimal  @db.Decimal(10, 2)
  costPrice       Decimal  @db.Decimal(10, 2)
  stockQuantity   Int      @default(0)
  minStockLevel   Int      @default(0)
  maxStockLevel   Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       Int?
  updatedBy       Int?
  damagedQuantity Int      @default(0)

  // Relations
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  type            ProductType     @relation(fields: [typeId], references: [id])
  shop            Shop            @relation(fields: [shopId], references: [id])
  saleItems       SaleItem[]
  stockEntries    StockEntry[]
  specialPrices   CustomerSpecialPrice[]
  salesAnalytics  ProductSalesAnalytics[]
}

model DailyProductPrice {
  id        BigInt   @id @default(sequence())
  productId Int
  date      DateTime
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@unique([productId, date])
}

model MiscExpense {
  id          BigInt   @id @default(sequence())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Int?
  updatedBy   Int?
}

model Supplier {
  id                    Int                    @id @default(sequence(maxValue: 2147483647))
  name                  String
  contactPerson         String?
  phone                 String?
  email                 String?
  address               String?
  shopId                Int
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdBy             Int?
  updatedBy             Int?
  stockEntries          StockEntry[]
  shop                  Shop                   @relation(fields: [shopId], references: [id])
  supplierPayments      SupplierPayment[]
  supplierWeeklyReports SupplierWeeklyReport[]
}

model Employee {
  id        Int      @id @default(sequence(maxValue: 2147483647))
  name      String
  phone     String?
  email     String?
  salary    Decimal  @db.Decimal(10, 2)
  shopId    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy Int?
  updatedBy Int?
  positions String[]

  // Relations
  shop      Shop     @relation(fields: [shopId], references: [id])
}

model StockEntry {
  id            BigInt        @id @default(sequence())
  productId     Int
  supplierId    Int
  quantity      Int
  unitPrice     Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  entryDate     DateTime
  notes         String?
  shopId        Int
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     Int?
  updatedBy     Int?
  paymentStatus PaymentStatus @default(PENDING)
  
  // Relations
  product       Product       @relation(fields: [productId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  shop          Shop          @relation(fields: [shopId], references: [id])
}

model SupplierPayment {
  id            BigInt        @id @default(sequence())
  supplierId    Int
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  shopId        Int
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     Int?
  updatedBy     Int?
  week          String?
  shop          Shop          @relation(fields: [shopId], references: [id])
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
}

model SupplierWeeklyReport {
  id             BigInt   @id @default(sequence())
  supplierId     Int
  weekStartDate  DateTime
  weekEndDate    DateTime
  totalPurchases Decimal  @db.Decimal(10, 2)
  totalPayments  Decimal  @db.Decimal(10, 2)
  balance        Decimal  @db.Decimal(10, 2)
  shopId         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      Int?
  updatedBy      Int?
  shop           Shop     @relation(fields: [shopId], references: [id])
  supplier       Supplier @relation(fields: [supplierId], references: [id])
}

model EmployeePayment {
  id            BigInt        @id @default(sequence())
  employeeId    Int
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  shopId        Int
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     Int?
  updatedBy     Int?

  // Relations
  shop          Shop          @relation(fields: [shopId], references: [id])
}

model EmployeeSalaryDue {
  id           BigInt   @id @default(sequence())
  employeeId   Int
  month        Int
  year         Int
  salaryAmount Decimal  @db.Decimal(10, 2)
  paidAmount   Decimal  @db.Decimal(10, 2)
  dueAmount    Decimal  @db.Decimal(10, 2)
  isPaid       Boolean  @default(false)
  shopId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    Int?
  updatedBy    Int?

  // Relations
  shop         Shop     @relation(fields: [shopId], references: [id])

  @@unique([employeeId, month, year])
}

model Customer {
  id             Int          @id @default(sequence(maxValue: 2147483647))
  name           String
  phone          String?      @unique
  email          String?      @unique
  address        String?
  customerType   CustomerType @default(REGULAR)
  creditLimit    Decimal      @default(0) @db.Decimal(10, 2)
  currentBalance Decimal      @default(0) @db.Decimal(10, 2)
  shopId         Int
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      Int?
  updatedBy      Int?
  isWalkIn       Boolean      @default(false)

  // Relations
  shop           Shop         @relation(fields: [shopId], references: [id])
  sales          Sale[]
  ledgerEntries  CustomerLedgerEntry[]
  specialPrices  CustomerSpecialPrice[]
}

model CustomerSpecialPrice {
  id           BigInt    @id @default(sequence())
  customerId   Int
  productId    Int
  specialPrice Decimal   @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    Int?
  updatedBy    Int?

  // Relations
  customer     Customer  @relation(fields: [customerId], references: [id])
  product      Product   @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

model CustomerLedgerEntry {
  id            BigInt         @id @default(sequence())
  customerId    Int
  date          DateTime
  description   String
  debitAmount   Decimal        @default(0) @db.Decimal(10, 2)
  creditAmount  Decimal        @default(0) @db.Decimal(10, 2)
  balance       Decimal        @db.Decimal(10, 2)
  reference     String?
  shopId        Int
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     Int?
  updatedBy     Int?
  paymentMethod PaymentMethod?

  // Relations
  customer      Customer       @relation(fields: [customerId], references: [id])
  shop          Shop           @relation(fields: [shopId], references: [id])
}

model CustomerLedgerItem {
  id            BigInt   @id @default(sequence())
  ledgerEntryId BigInt
  productId     Int?
  quantity      Int?
  unitPrice     Decimal? @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     Int?
  updatedBy     Int?
  unit          String   @default("units")
}

model Sale {
  id            BigInt        @id @default(sequence())
  customerId    Int
  shopId        Int
  saleDate      DateTime
  totalAmount   Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  dueAmount     Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     Int?
  updatedBy     Int?

  // Relations
  customer      Customer      @relation(fields: [customerId], references: [id])
  shop          Shop          @relation(fields: [shopId], references: [id])
  items         SaleItem[]
  payments      Payment[]
}

model SaleItem {
  id         BigInt   @id @default(sequence())
  saleId     BigInt
  productId  Int
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  discount   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  Int?
  updatedBy  Int?
  unit       String   @default("units")

  // Relations
  sale       Sale     @relation(fields: [saleId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id            BigInt        @id @default(sequence())
  saleId        BigInt?
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  paymentDate   DateTime
  reference     String?
  notes         String?
  shopId        Int
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     Int?
  updatedBy     Int?

  // Relations
  sale          Sale?         @relation(fields: [saleId], references: [id])
  shop          Shop          @relation(fields: [shopId], references: [id])
}

model Expense {
  id          BigInt   @id @default(sequence())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String
  date        DateTime
  shopId      Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Int?
  updatedBy   Int?

  // Relations
  shop        Shop     @relation(fields: [shopId], references: [id])
}

model AnalyticsSummary {
  id             BigInt   @id @default(sequence())
  shopId         Int
  date           DateTime
  totalSales     Decimal  @db.Decimal(10, 2)
  totalExpenses  Decimal  @db.Decimal(10, 2)
  netProfit      Decimal  @db.Decimal(10, 2)
  totalProducts  Int
  totalCustomers Int
  totalSuppliers Int
  totalEmployees Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      Int?
  updatedBy      Int?

  // Relations
  shop           Shop     @relation(fields: [shopId], references: [id])

  @@unique([shopId, date])
}

model ProductSalesAnalytics {
  id           BigInt   @id @default(sequence())
  productId    Int
  shopId       Int
  date         DateTime
  quantitySold Int
  totalRevenue Decimal  @db.Decimal(10, 2)
  averagePrice Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    Int?
  updatedBy    Int?

  // Relations
  product      Product  @relation(fields: [productId], references: [id])
  shop         Shop     @relation(fields: [shopId], references: [id])

  @@unique([productId, shopId, date])
}

model SystemSetting {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model OTP {
  id        BigInt   @id @default(sequence())
  email     String
  otp       String
  type      String
  userId    Int
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([expiresAt])
}

model TmtCompany {
  id          BigInt       @id @default(autoincrement())
  name        String       @unique
  location    String?
  contactInfo String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  tmtProducts TmtProduct[]

  @@map("tmt_companies")
}

model TmtSize {
  id          BigInt       @id @default(autoincrement())
  sizeMm      BigInt       @unique
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  tmtProducts TmtProduct[]

  @@map("tmt_sizes")
}

model TmtProduct {
  id                BigInt           @id @default(autoincrement())
  companyId         BigInt
  sizeId            BigInt
  productName       String
  weightPerRodKg    Decimal          @db.Decimal(8, 3)
  rodsPerBundle     BigInt
  weightPerBundleKg Decimal          @db.Decimal(8, 3)
  defaultUnit       String           @default("bundle")
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  company           TmtCompany       @relation(fields: [companyId], references: [id])
  size              TmtSize          @relation(fields: [sizeId], references: [id])
  unitConversions   UnitConversion[]
  inventory         TmtInventory[]

  @@unique([companyId, sizeId])
  @@index([companyId])
  @@index([sizeId])
  @@map("tmt_products")
}

model TmtPurchase {
  id             BigInt            @id @default(autoincrement())
  invoiceNumber  String
  supplierName   String
  totalWeightTon Decimal           @db.Decimal(10, 3)
  dateReceived   DateTime          @db.Timestamptz(6)
  remarks        String?
  shopId         Int
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy      BigInt?
  updatedBy      BigInt?
  items          TmtPurchaseItem[]
  shop           Shop                @relation(fields: [shopId], references: [id])

  @@map("tmt_purchases")
}

model TmtPurchaseItem {
  id                BigInt      @id @default(autoincrement())
  purchaseId        BigInt
  productId         BigInt
  quantity          Decimal     @db.Decimal(10, 3)
  unitType          String
  weightPerRodKg    Decimal     @db.Decimal(8, 3)
  rodsPerBundle     BigInt
  weightPerBundleKg Decimal     @db.Decimal(8, 3)
  totalBundles      Decimal     @db.Decimal(10, 3)
  totalPieces       Decimal     @db.Decimal(10, 3)
  equivalentKg      Decimal     @db.Decimal(10, 3)
  remarks           String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  purchase          TmtPurchase @relation(fields: [purchaseId], references: [id])

  @@map("tmt_purchase_items")
}

model TmtInventory {
  id             BigInt      @id @default(autoincrement())
  productId      BigInt
  availableQtyKg Decimal     @db.Decimal(12, 3)
  reservedQtyKg  Decimal     @default(0) @db.Decimal(12, 3)
  lastUpdated    DateTime    @default(now()) @db.Timestamptz(6)
  shopId         Int
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  product        TmtProduct @relation(fields: [productId], references: [id])
  shop           Shop       @relation(fields: [shopId], references: [id])

  @@unique([productId, shopId])
  @@map("tmt_inventory")
}

model TmtSale {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt
  soldQuantity Decimal  @db.Decimal(10, 3)
  unitType     String
  equivalentKg Decimal  @db.Decimal(10, 3)
  pricePerUnit Decimal  @db.Decimal(10, 2)
  totalAmount  Decimal  @db.Decimal(10, 2)
  saleDate     DateTime @db.Timestamptz(6)
  customerName String?
  shopId       Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy    BigInt?
  updatedBy    BigInt?
  shop         Shop     @relation(fields: [shopId], references: [id])

  @@map("tmt_sales")
}

model TmtSaleItem {
  id           BigInt   @id @default(autoincrement())
  saleId       BigInt
  productId    BigInt
  soldQuantity Decimal  @db.Decimal(10, 3)
  unitType     String
  equivalentKg Decimal  @db.Decimal(10, 3)
  pricePerUnit Decimal  @db.Decimal(10, 2)
  totalAmount  Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("tmt_sale_items")
}

model UnitConversion {
  id               BigInt      @id @default(autoincrement())
  productId        BigInt?
  fromUnit         String
  toUnit           String
  conversionFactor Decimal     @db.Decimal(10, 6)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  product          TmtProduct? @relation(fields: [productId], references: [id])

  @@unique([productId, fromUnit, toUnit])
  @@map("unit_conversions")
}

// TMT Bar Stock Management
model TmtBar {
  id              String   @id @default(cuid())
  companyName     String
  sizeMM          Float
  bundleSize      Int
  weightPerPiece  Float
  bundleWeight    Float
  arrivalTons     Float
  totalBundles    Int
  totalPieces     Int
  sellByWeight    Boolean  @default(true)
  sellByBundle    Boolean  @default(false)
  sellByPiece     Boolean  @default(false)
  mixedLoad       Boolean  @default(false)
  shopId          Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  shop            Shop     @relation(fields: [shopId], references: [id])
  
  @@map("tmt_bars")
}

enum UserRole {
  SUPER_DUPER_ADMIN
  SUPER_ADMIN
  ADMIN
  USER
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CustomerType {
  REGULAR
  WHOLESALE
  RETAIL
  CONTRACTOR
}
